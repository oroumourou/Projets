# Dupliquez ce fichier sous le nom .env et adaptez les valeurs.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/campus_papers

# Générez une longue valeur aléatoire (au moins 32 caractères).
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Adresse du frontend autorisée à appeler l'API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Les fichiers restent sur le disque de cette machine.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
